# Copy this file to backup.env (gitignored) in the same folder and fill in
# real values for your deployment. backup.env is read by every script via
# Get-BackupConfig in Common.ps1 - see docs/backup-runbook.md for the full
# setup walkthrough.
#
# Anything left blank falls back to a dev-only default that lives inside
# this repo (backend/backup/secrets, /staging, /local-repo - all gitignored).
# That default is NOT a real 3-2-1 arrangement: it's a second folder on the
# SAME disk as the live database, which the task this was built against
# explicitly calls out as not satisfying "a separate local backup device."
# Real use requires setting BACKUP_LOCAL_DEVICE_PATH below to a path on an
# actual external drive, and BACKUP_SECRETS_DIR to a path outside both this
# repo and any cloud-synced folder (e.g. NOT under OneDrive).

# --- Database connection (the constructiq_backup identity, not app root) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=constructiq
BACKUP_MYSQL_USER=constructiq_backup
MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.0\bin

# --- Secrets (never put real values in THIS .example file) ---
# Directory containing: mysql-backup-user-password.txt, restic-password.txt,
# backup-report-token.txt, b2-key-id.txt, b2-application-key.txt. MUST be
# relocated off this disk / out of any cloud-synced folder before this is a
# real production setup - e.g. C:\ConstructIQ-Backup-Secrets, ACL-locked to
# the single Windows identity the scheduled tasks run as. The B2 key/secret
# live here, NOT as plain BACKUP_S3_* values in this file, because this file
# itself stays inside the repo (gitignored, but still under OneDrive).
BACKUP_SECRETS_DIR=

# --- Copy 2: local backup device (a genuinely separate physical device) ---
# e.g. E:\ConstructIQ-Backups\restic-repo on an external/portable drive.
BACKUP_LOCAL_DEVICE_PATH=

# --- Copy 3: off-site cloud (any S3-compatible endpoint) ---
# Bucket name and endpoint only - NOT credentials (those are read from
# BACKUP_SECRETS_DIR\b2-key-id.txt and b2-application-key.txt).
# Leave BACKUP_S3_BUCKET empty to explicitly skip cloud delivery (scripts
# will log this and report cloudSuccess=null, never a false "success").
BACKUP_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
BACKUP_S3_BUCKET=

# --- Where the app's own upload folder lives (Copy 1 for files) ---
BACKUP_UPLOADS_PATH=

# --- Reporting back to ConstructIQ.API ---
BACKUP_API_URL=http://localhost:5000/api/v1/system/backup-jobs/report

# --- Retention & schedule metadata ---
BACKUP_RETENTION_LOCAL_DAYS=30
BACKUP_RETENTION_CLOUD_DAYS=90
BACKUP_TIMEZONE=Asia/Manila
