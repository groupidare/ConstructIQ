# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_ML_URL=http://localhost:8000
# Same Client ID as GOOGLE_CLIENT_ID below — Client IDs are public by design,
# unlike a Client Secret, so it's safe to expose to the browser here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── Backend ────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=constructiq
DB_USER=root
DB_PASSWORD=your_password

JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_ISSUER=ConstructIQ
JWT_AUDIENCE=ConstructIQUsers
JWT_EXPIRES_HOURS=24

ML_SERVICE_URL=http://localhost:8000

# Gmail account used to send password-reset emails. SMTP_APP_PASSWORD is a
# 16-character App Password from Google Account > Security > 2-Step Verification
# > App Passwords — NOT your regular Gmail password.
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password

# Google OAuth Client ID (Web application) from Google Cloud Console > APIs & Services
# > Credentials. Only used to verify Google sign-in ID tokens — no Client Secret needed.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── ML Service ─────────────────────────────────────────────
ML_DB_HOST=localhost
ML_DB_PORT=3306
ML_DB_NAME=constructiq_db
ML_DB_USER=root
ML_DB_PASSWORD=your_password
