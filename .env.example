# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_ML_URL=http://localhost:8000
# Same Client ID as GOOGLE_CLIENT_ID below — Client IDs are public by design,
# unlike a Client Secret, so it's safe to expose to the browser here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── Backend ────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=constructiq
DB_USER=root
DB_PASSWORD=your_password
# Preferred (default, opportunistic TLS) works unchanged for local MySQL with
# no TLS configured. Set to Required (or VerifyCA/VerifyFull) for a managed
# host that enforces TLS, e.g. Aiven.
DB_SSL_MODE=Preferred

JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_ISSUER=ConstructIQ
JWT_AUDIENCE=ConstructIQUsers
JWT_EXPIRES_HOURS=24

ML_SERVICE_URL=http://localhost:8000

# Gmail account used to send password-reset emails. SMTP_APP_PASSWORD is a
# 16-character App Password from Google Account > Security > 2-Step Verification
# > App Passwords — NOT your regular Gmail password.
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password

# Google OAuth Client ID (Web application) from Google Cloud Console > APIs & Services
# > Credentials. Only used to verify Google sign-in ID tokens — no Client Secret needed.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Shared secret the unattended Backup-Daily.ps1/Backup-Weekly.ps1 scripts
# send as the X-Backup-Report-Token header when POSTing a job result to
# /api/v1/system/backup-jobs/report. Generate your own (do NOT reuse
# JWT_SECRET) - see backend/backup/scripts/Setup-BackupMySqlUser.ps1's sibling
# secret-generation pattern, or docs/backup-runbook.md step 4.
BACKUP_REPORT_TOKEN=generate_a_random_64_char_hex_value

# ─── ML Service ─────────────────────────────────────────────
# forecasting_service.get_engine() reads this single connection URL — there
# is no separate ML_DB_HOST/PORT/NAME/USER/PASSWORD; setting those instead
# does nothing and silently falls back to the docker-compose default below.
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/constructiq
# Path to a managed host's (e.g. Aiven) downloaded CA certificate, to enable
# TLS. Leave unset for local/docker-compose (no TLS configured).
DB_SSL_CA=
